# --- Chain ---
# One of: robinhood | robinhood-testnet | ethereum | base | arbitrum
# Robinhood Chain = Arbitrum-stack L2, chainId 4663, gas paid in ETH
CHAIN=robinhood
# Leave blank to use the public endpoint https://rpc.mainnet.chain.robinhood.com
# A dedicated provider (Alchemy / Chainstack / Dwellir) is better for a hunter.
RPC_HTTP_URL=
# Optional - needed for live block/pending streams. Blank = polling fallback.
RPC_WS_URL=

# --- Wallet ---
# Private key of a BURNER wallet only. Never a wallet holding real funds.
PRIVATE_KEY=

# --- Safety rails ---
# DRY_RUN=true simulates and logs; it never broadcasts a transaction.
DRY_RUN=true
# Hard cap on gas price (gwei) the bot will ever pay
MAX_GAS_GWEI=30
# Hard cap on ETH value per mint tx. A "free mint" should be 0.
MAX_MINT_VALUE_ETH=0
# Stop the whole bot once this much ETH has been spent on gas in one run
DAILY_GAS_BUDGET_ETH=0.05
# Max mint attempts per contract, and overall per run
MAX_MINTS_PER_CONTRACT=1
MAX_MINTS_PER_RUN=5

# --- Logging ---
LOG_LEVEL=info

# --- OpenSea scanning ---
# API v2 requires a key: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=
# OpenSea chain slug. "robinhood" = Robinhood Chain.
OPENSEA_CHAIN=robinhood
OPENSEA_PAGE_SIZE=50
POLL_INTERVAL_MS=30000

# --- Drop watching ---
# How often an upcoming drop is re-inspected on-chain (ms)
WATCH_RECHECK_MS=300000
# Wake this long before a scheduled mint start, to arm in advance (ms)
ARM_LEAD_MS=15000
# Attempt mints on contracts with no readable schedule (noisy)
MINT_UNKNOWN_SCHEDULE=false
# How far back to backfill SeaDrop schedule events on startup
SEADROP_BACKFILL_BLOCKS=20000
# Max block span per eth_getLogs call
LOG_CHUNK_SIZE=5000

# --- Eligibility ---
# Paid mints need this credibility score (0-100). Free mints bypass it.
MIN_CREDIBILITY=75
# Hard USD cap on a paid mint price
MAX_PAID_MINT_USD=1
# Pin ETH/USD instead of fetching live (0 = fetch)
ETH_USD_PRICE=0
PRICE_CACHE_MS=300000
EXPLORER_API_BASE=https://robinhoodchain.blockscout.com
EXPLORER_TIMEOUT_MS=8000
# Let an explorer scam-flag block free mints too (spec: free bypasses checks)
VETO_APPLIES_TO_FREE=false

# --- Persistence ---
# Where mint results are saved (gitignored)
LEDGER_PATH=data/mints.json
# Give up on a contract after this many failed mint attempts
MAX_ATTEMPTS_PER_CONTRACT=3
